PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
MARKET_DATA_POLL_INTERVAL_MS=2000
MARKET_DATA_STALE_AFTER_MS=10000
MARKET_DATA_OFFLINE_AFTER_MS=30000

# Supabase — server-side only. NEVER expose to frontend or commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Alert Delivery — server-side only. NEVER expose to frontend or commit real values.
# Obtain from https://t.me/BotFather after creating a bot.
TELEGRAM_BOT_TOKEN=
# The chat_id of the Telegram chat to receive alerts (user, group, or channel).
TELEGRAM_CHAT_ID=

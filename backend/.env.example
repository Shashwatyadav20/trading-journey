PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
MARKET_DATA_POLL_INTERVAL_MS=2000
MARKET_DATA_STALE_AFTER_MS=10000
MARKET_DATA_OFFLINE_AFTER_MS=30000

# Supabase — server-side only. NEVER expose to frontend or commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Alert Delivery — server-side only. NEVER expose to frontend or commit real values.
# Obtain from https://t.me/BotFather after creating a bot.
TELEGRAM_BOT_TOKEN=
# The chat_id of the Telegram chat to receive alerts (user, group, or channel).
TELEGRAM_CHAT_ID=

# Twelve Data Market Data API — server-side only (XAU/USD). NEVER expose to frontend or commit real values.
# Obtain your API key from https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=
# Polling interval in milliseconds for live XAU/USD price feed.
# Default: 15000ms (15 seconds). Respect your plan's rate limits (~8 req/min).
# Do NOT set below 7500ms (8 req/min plan). Recommended: 15000 or higher.
TWELVE_DATA_POLL_INTERVAL_MS=15000

# ── Indian Market (NIFTY) Configuration ───────────────────────────────────────
# Data provider for live NIFTY option chain. Options: NSE_INDIA | DHAN
NIFTY_DATA_PROVIDER=NSE_INDIA
# How long (ms) before NSE option chain data is considered stale.
NSE_OPTION_CHAIN_STALE_MS=60000

# ── CRITICAL PRODUCTION SAFETY INVARIANT ──────────────────────────────────────
# Must be set to "true" in ALL environments (local + Render + Vercel backend).
# When true: missing live NIFTY data → NO_TRADE (never synthetic fallback).
# Render Dashboard: Settings → Environment Variables → INDIAN_REAL_DATA_ONLY = true
INDIAN_REAL_DATA_ONLY=true

# ── Dhan Broker (optional — for live option chain feed) ────────────────────────
# Server-side only. NEVER expose to frontend. Leave blank if not using Dhan.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
